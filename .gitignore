# Secrets - NEVER commit these
.env
client_secret.json
youtube_token.json
*.token

# Generated media
**/renders/**
*.wav
*.mp4
# Ignore mp3s by default, but allow them in specific asset/channel folders
**/*.mp3
!assets/**/*.mp3
!channels/**/music/*.mp3

# Python / Node
__pycache__/
*.pyc
node_modules/
*.log
