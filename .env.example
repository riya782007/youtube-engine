# Rename this file to  .env  (just ".env", no .example) and keep it in the project root.
# Do NOT commit this file to git or paste any key in chat. (.env is gitignored.)
# Everything degrades gracefully - a missing optional key just disables that feature.

# ============================================================================
#  REQUIRED for the daily agent
# ============================================================================

# ---- Script generation: at least ONE of these LLM keys ----------------------
# Groq is free, fast and great at Hinglish - the recommended default.
#   Get it at  https://console.groq.com  -> API Keys  (starts with gsk_)
GROQ_API_KEY=
# Optional extra LLM fallbacks (any one is enough; provider precedence is
# Claude -> Groq -> Gemini -> BluesMinds):
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
BLUESMINDS_API_KEY=

# ---- Voice (required) -------------------------------------------------------
# Sarvam Bulbul v3 - Hindi/Hinglish TTS. Get/regenerate at https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_your_key_here

# ---- Email summary (required for the daily delivery) ------------------------
# Use a Gmail App Password (NOT your normal password). See AGENT_SETUP.md Step 2.
AGENT_EMAIL_FROM=your_email@gmail.com
AGENT_EMAIL_TO=recipient_email@gmail.com
AGENT_EMAIL_APP_PASSWORD=your_16_char_app_password

# ============================================================================
#  RECOMMENDED (big quality jumps, all have free tiers)
# ============================================================================

# ---- Stock footage behind every scene --------------------------------------
# Pexels - free portrait B-roll. https://www.pexels.com/api/  (200 req/hour free)
PEXELS_API_KEY=

# ---- Natural-voice upgrade (the pronunciation fix) --------------------------
# If present, the engine AUTOMATICALLY uses ElevenLabs multilingual (much more
# natural Hindi/Hinglish) instead of Sarvam. Leave blank to stay on Sarvam.
# Get a key at https://elevenlabs.io  (free tier available).
ELEVENLABS_API_KEY=
# Optional per-channel voice overrides (else sensible defaults are used):
#   ELEVENLABS_VOICE_AI=TX3LPaxmHKxFdv7VOQHJ
#   ELEVENLABS_VOICE_FINANCE=EXAVITQu4vr4xnSDxMaL
#   ELEVENLABS_VOICE_BUSINESS=JBFqnCBsd6RMkjVDRZzb

# ---- Sound effects (whoosh on cuts + ding on payoff) ------------------------
# Freesound CC0 SFX, fresh per render. Free key at https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# ---- Background music (auto, royalty-free) ----------------------------------
# Jamendo Music API. Without this, the engine uses channels/<id>/music/bgm.mp3
# (download those manually from YouTube Audio Library - see AUDIO_GUIDE.md).
# Get a FREE Client ID at  https://devportal.jamendo.com  (create an app).
# NOTE: Jamendo tracks are Creative Commons - many require attribution. The engine
# writes music_credits.txt into each render folder. For zero-attribution,
# monetization-safe music, prefer the manual YouTube Audio Library path.
JAMENDO_CLIENT_ID=

# ============================================================================
#  YOUTUBE UPLOAD (optional - only when you wire auto/assisted uploads)
# ============================================================================
# Path to the OAuth client secret JSON downloaded from Google Cloud.
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Created automatically on first authorized upload; leave as-is.
YOUTUBE_TOKEN_FILE=youtube_token.json
