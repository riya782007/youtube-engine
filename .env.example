# Rename this file to  .env  (just ".env", no .example) and keep it in the project root.
# Do NOT commit this file to git or paste any key in chat. (.env is gitignored.)

# ---- Voice (required) -------------------------------------------------------
# Sarvam Bulbul v3 - Hinglish TTS. Get/regenerate at https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_your_key_here

# ---- Stock footage (recommended) -------------------------------------------
# Pexels - free portrait B-roll behind every scene. Get a key at
# https://www.pexels.com/api/  (free tier: 200 requests/hour - plenty).
PEXELS_API_KEY=your_pexels_key_here

# ---- Voice upgrade (optional, the natural-pronunciation fix) ----------------
# If this key is present the engine AUTOMATICALLY uses ElevenLabs multilingual
# (much more natural Hindi) instead of Sarvam. Leave blank to stay on Sarvam.
# Get a key at https://elevenlabs.io  (free tier available).
ELEVENLABS_API_KEY=
# Optional voice overrides (else sensible defaults are used):
#   ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM        # one voice for everything
#   ELEVENLABS_VOICE_AI=pNInz6obpgDQGcFmaJgB        # per-channel override
#   ELEVENLABS_VOICE_FINANCE=21m00Tcm4TlvDq8ikWAM
#   ELEVENLABS_VOICE_BUSINESS=ErXwobaYiN019PkySvjV

# ---- YouTube upload (fill in LATER, when we wire uploads) -------------------
# Path to the OAuth client secret JSON you'll download from Google Cloud.
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Created automatically on first authorized upload; leave as-is.
YOUTUBE_TOKEN_FILE=youtube_token.json
